<shad:ShadWindow xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shad="clr-namespace:Ti.Avalonia.Shadcn.Controls;assembly=Ti.Avalonia.Shadcn"
 xmlns:local="using:WebSearch.Views"
 x:Class="WebSearch.Views.WebsiteWindow" Title="网页" Width="1100" Height="780"
 MinWidth="580" MinHeight="400" CanPin="True">
 <Grid x:Name="WebsiteContent">
  <local:WebsiteWebView x:Name="Browser" />
  <Popup x:Name="NoticePopup" PlacementTarget="{Binding #Browser}"
   Placement="AnchorAndGravity" PlacementAnchor="TopRight" PlacementGravity="BottomLeft"
   HorizontalOffset="-12" VerticalOffset="12" IsLightDismissEnabled="False">
   <Border MaxWidth="480" Padding="12" CornerRadius="8"
    Background="{DynamicResource ShadCardBrush}" BorderBrush="{DynamicResource ShadBorderBrush}" BorderThickness="1">
    <StackPanel Spacing="8">
     <TextBlock x:Name="StatusText" IsVisible="False" TextWrapping="Wrap"
      Foreground="{DynamicResource ShadForegroundBrush}" />
     <StackPanel x:Name="PopupBar" Orientation="Horizontal" Spacing="6" IsVisible="False">
      <TextBlock Text="已拦截自动弹窗" VerticalAlignment="Center" />
      <Button Content="允许此次" Click="OnAllowPopup" />
      <Button Content="此网站始终允许" Click="OnAlwaysAllowPopup" />
     </StackPanel>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</shad:ShadWindow>

